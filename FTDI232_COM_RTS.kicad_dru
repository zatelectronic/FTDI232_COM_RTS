(version 1)

# USB-C GCT USB4105-GF-A (J1): os pads A1/B12, A4/B9, B1/A12, B4/A9 ficam
# a 0,175-0,21 mm dos furos NPTH de guia — geometria do land pattern do fabricante.
# Isolamento furo-cobre reduzido SOMENTE dentro do próprio conector (mesma regra do DEVKIT V1 PIC18F4550).
# Conferir com o fabricante (JLCPCB: NPTH-cobre >= 0,15 mm).
(rule "USB4105 NPTH guia"
	(constraint hole_clearance (min 0.15mm))
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')"))
